# Pooled URL for the app (Neon pooler). Migrations use DATABASE_URL_UNPOOLED via prisma directUrl.
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://...?sslmode=require"
# Required for login (min 32 characters). Set the same value on your Vercel account’s project env.
AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SEED_ADMIN_PASSWORD="admin123"
