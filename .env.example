# Neon — use the **pooled** connection string for Vercel/serverless:
# postgresql://USER:PASS@HOST/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fast2SMS — leave empty to use dev OTP (shown to delivery user in app)
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID="FSTSMS"
FAST2SMS_ROUTE="otp"
SMS_DEV_MODE="true"

DEFAULT_COUNTRY="IN"

# First-run seed (only when no users exist)
SEED_OWNER_EMAIL="owner@agentic.local"
SEED_OWNER_PASSWORD="changeme123"

# Optional: password reset emails (logs to console when unset)
RESEND_API_KEY=""
EMAIL_FROM="Agentic Logistics <noreply@yourdomain.com>"

ELECTRON_APP_URL="http://localhost:3000"
